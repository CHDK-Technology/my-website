+// backend/scripts/seedDocuments.js
+// Run once: node scripts/seedDocuments.js
+// Edit the array below, then place the matching PDF files in backend/private-docs/
+
+require('dotenv').config();
+const mongoose = require('mongoose');
+const Document = require('../models/Document');
+
+const sampleDocs = [
+  {
+    title: 'Solar Dryer Product Brochure',
+    slug: 'solar-dryer-brochure',
+    category: 'brochure',
+    description: 'Full specifications and use-cases for the CHDK Solar Food Dehydrator range.',
+    price: 199,
+    fileName: 'solar-dryer-brochure.pdf' // must exist in backend/private-docs/
+  },
+  {
+    title: 'Product Catalogue 2026',
+    slug: 'product-catalogue-2026',
+    category: 'catalogue',
+    description: 'Complete CHDK product catalogue across all business verticals.',
+    price: 299,
+    fileName: 'product-catalogue-2026.pdf'
+  },
+  {
+    title: 'Dehydration SOP Manual',
+    slug: 'dehydration-sop-manual',
+    category: 'sop',
+    description: 'Standard Operating Procedure for solar dryer operation and maintenance.',
+    price: 149,
+    fileName: 'dehydration-sop-manual.pdf'
+  },
+  {
+    title: 'Farm-to-Table Recipe Book',
+    slug: 'farm-to-table-recipe-book',
+    category: 'recipe-book',
+    description: 'Recipes using solar-dried produce, curated for home and commercial kitchens.',
+    price: 99,
+    fileName: 'farm-to-table-recipe-book.pdf'
+  }
+];
+
+async function seed() {
+  await mongoose.connect(process.env.MONGO_URI);
+  console.log('Connected to MongoDB');
+
+  for (const doc of sampleDocs) {
+    await Document.findOneAndUpdate(
+      { slug: doc.slug },
+      doc,
+      { upsert: true, new: true }
+    );
+    console.log(`Upserted: ${doc.title}`);
+  }
+
+  await mongoose.disconnect();
+  console.log('Done.');
+}
+
+seed().catch((err) => {
+  console.error(err);
+  process.exit(1);
+});
